# Vercel ignore file
# Files and directories to exclude from Vercel deployment

# Dependencies
node_modules/
**/node_modules/

# Build outputs (will be generated)
**/build/
**/dist/

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Server files (deploy separately)
server/
ai-services/
backend/
speech-service/
video-service/

# Development files
.vscode/
.idea/
*.swp
*.swo
*~

# Test files
**/__tests__/
**/*.test.js
**/*.test.ts
**/*.spec.js
**/*.spec.ts

# Documentation
*.md
!README.md

# Temporary files
temp/
tmp/
uploads/

# Git
.git/
.gitignore

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Kubernetes
k8s/

# Scripts
scripts/

# Other
.DS_Store
Thumbs.db


