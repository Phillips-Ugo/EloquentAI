# Communication Coach Environment Configuration

# API Configuration
API_V1_STR=/api
PROJECT_NAME=Communication Coach
VERSION=1.0.0
DEBUG=true

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://localhost:3000,https://localhost:3001

# Database Configuration
DATABASE_URL=sqlite:///./communication_coach.db
# For PostgreSQL:
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=communication_coach

# Redis Configuration
REDIS_URL=redis://localhost:6379

# ML Model Configuration
MODEL_CACHE_DIR=./models
AUDIO_MODEL_PATH=./models/audio_emotion_model.pt
MAX_AUDIO_FILE_SIZE=104857600
SUPPORTED_AUDIO_FORMATS=audio/wav,audio/mp3,audio/m4a,audio/aac

# Audio Processing Configuration
TARGET_SAMPLE_RATE=16000
TARGET_CHANNELS=1
MAX_AUDIO_DURATION=300

# Heuristics Configuration
EYE_CONTACT_YAW_THRESHOLD=15.0
EYE_CONTACT_PITCH_THRESHOLD=12.0
SMILE_RATIO_THRESHOLD=0.38
POSTURE_WARNING_ANGLE=12.0
POSTURE_CRITICAL_ANGLE=25.0
FIDGET_VELOCITY_THRESHOLD=0.18

# Speech Analysis Configuration
IDEAL_WPM_MIN=120
IDEAL_WPM_MAX=160
SLOW_WPM_THRESHOLD=100
FAST_WPM_THRESHOLD=180

# Security Configuration
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=104857600

# Monitoring Configuration
SENTRY_DSN=
ENABLE_METRICS=true

# Development Configuration
MOCK_RESPONSES=true