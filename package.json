{
  "name": "eloquent-ai",
  "version": "2.0.0",
  "description": "Eloquent AI - Speech and Video Analysis Platform (Simplified Business Edition)",
  "main": "server/index.js",
  "proxy": "http://localhost:5001",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "install-all": "npm install && cd client && npm install",
    "setup": "npm run install-all && npm run build"
  },
  "keywords": [
    "ai",
    "speech-analysis",
    "video-analysis",
    "presentation-feedback",
    "communication-coaching"
  ],
  "author": "Eloquent AI Team",
  "license": "MIT",
          "dependencies": {
          "express": "^4.18.2",
          "cors": "^2.8.5",
          "helmet": "^7.1.0",
          "morgan": "^1.10.0",
          "multer": "^1.4.5-lts.1",
          "axios": "^1.6.0",
          "dotenv": "^16.3.1",
          "express-rate-limit": "^7.1.5",
          "compression": "^1.7.4",
          "express-validator": "^7.0.1",
          "uuid": "^9.0.1",
          "fs-extra": "^11.1.1",
          "path": "^0.12.7"
        },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
} 